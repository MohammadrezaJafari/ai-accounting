APP_NAME="AI Accounting"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Customer panel address used in invitation emails (defaults to APP_URL).
PANEL_URL=http://localhost:9000

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- AI gateway & billing ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password
BILLING_DEFAULT_MARKUP_BPS=2000
BILLING_MIN_BALANCE_USD=0
BILLING_CUSTOM_TOPUP_ENABLED=true
BILLING_CUSTOM_TOPUP_MIN_USD=5
BILLING_CUSTOM_TOPUP_MAX_USD=1000
# manual = admin approves orders, zarinpal = Zarinpal, fake = auto-paid (development only)
BILLING_PAYMENT_GATEWAY=manual
# Zarinpal: merchant id, sandbox mode, and the Toman price of 1 USD orders are charged at
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
ZARINPAL_TOMAN_PER_USD=
GATEWAY_UPSTREAM_TIMEOUT=600
# Gateway requests per minute per API key (0 = unlimited) and the most a customer may set on a key
GATEWAY_RATE_LIMIT_PER_MINUTE=60
GATEWAY_RATE_LIMIT_MAX_PER_MINUTE=600
BILLING_DISPLAY_TIMEZONE=Asia/Tehran

# Bots agents send reports with (customers can also use their own bot token)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
BALE_BOT_TOKEN=
BALE_BOT_USERNAME=

# GapGPT as the upstream of every model (php artisan db:seed --class=CatalogSeeder after setting these)
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
GAPGPT_API_KEY=
GAPGPT_ROUTE_ALL_MODELS=false

# Marketplace publishers: default revenue share (%), model cost cap per run (USD), test runs per day.
# PUBLISHER_ALLOW_PRIVATE_ENDPOINTS=true only for developing agents on localhost.
PUBLISHER_REVENUE_SHARE=70
PUBLISHER_MAX_COST_PER_RUN_USD=0.10
PUBLISHER_MAX_COST_CEILING_USD=1.00
PUBLISHER_TEST_RUNS_PER_DAY=30
PUBLISHER_MAX_FREE_TRIAL_UNITS=10
PUBLISHER_TEST_RUN_DEBT_LIMIT_USD=5.00
PUBLISHER_PAYOUT_MIN_USD=10
PUBLISHER_DEPOSIT_MIN_USD=1
PUBLISHER_DEPOSIT_MAX_USD=1000
PUBLISHER_ALLOW_PRIVATE_ENDPOINTS=false

# --- Sign-in with the organization's identity provider and provisioning from the Rahap Hub ---
# Both optional: with OIDC_ISSUER and SERVICE_KEY empty everything works as before.
# Shared installation: OIDC_ISSUER=https://sso.example/realms/{tenant}
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_GROUPS_CLAIM=groups
OIDC_ROLES_CLAIM=roles
OIDC_AUTO_PROVISION=true
# true turns password sign-in and sign-up off (only while OIDC_ISSUER is set)
OIDC_ONLY=false
# Tenants accepted when the issuer has {tenant}, comma separated; empty = tenants the Hub provisioned
OIDC_TENANTS=
# Bearer key the Hub calls /api/service/v1 with; the endpoints answer 404 while it is empty
SERVICE_KEY=
